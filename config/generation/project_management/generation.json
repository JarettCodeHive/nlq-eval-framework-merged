      "Delivery",
      "Operations"
    ],
    "locations": [
      "NorthAmerica",
      "Europe",
      "AsiaPacific",
      "LatinAmerica",
      "Remote"
    ],
    "task_statuses": [
      "NotStarted",
      "InProgress",
      "Blocked",
      "Completed"
    ],
    "task_types": [
      "Feature",
      "Bug",
      "Documentation",
      "Testing",
      "Deployment"
    ],
    "assignment_roles": [
      "Owner",
      "Contributor",
      "Reviewer",
      "Approver"
    ],
    "milestone_types": [
      "Kickoff",
      "Design",
      "Build",
      "UAT",
      "Launch"
    ],
    "milestone_statuses": [
      "Planned",
      "AtRisk",
      "Completed",
      "Missed"
    ],
    "work_types": [
      "Delivery",
      "Review",
      "Meeting",
      "Rework",
      "Support"
    ],
    "project_name_prefixes": [
      "Atlas",
      "Beacon",
      "Cedar",
      "Horizon",
      "Nova",
      "Summit",
      "Vertex",
      "Vista"
    ],
    "project_name_subjects": [
      "Migration",
      "Modernization",
      "Platform",
      "Portal",
      "Quality",
      "Release",
      "Service",
      "Transformation"
    ],
    "task_name_actions": [
      "Build",
      "Configure",
      "Design",
      "Document",
      "Review",
      "Test",
      "Validate"
    ],
    "task_name_objects": [
      "API",
      "Dashboard",
      "Data Model",
      "Integration",
      "Release",
      "Service",
      "Workflow"
    ],
    "milestone_name_prefixes": [
      "Project",
      "Solution",
      "Delivery",
      "Quality",
      "Release"
    ],
    "time_entry_note_templates": [
      "Implementation work",
      "Review and validation",
      "Planning and coordination",
      "Testing and remediation",
      "Documentation update"
    ]
  },
  "generation_rules": {
    "date_windows": {
      "entity_created_start": "2022-01-01",
      "project_activity_start": "2024-01-01",
      "project_planning_horizon_end": "2027-12-31",
      "time_entry_activity_start": "2025-01-01"
    },
    "projects": {
      "date_range": {
        "start_source": "generation_rules.date_windows.project_activity_start",
        "end_source": "generation_rules.date_windows.project_planning_horizon_end"
      },
      "status_weights": {
        "Planning": 0.12,
        "Active": 0.42,
        "OnHold": 0.1,
        "Completed": 0.3,
        "Cancelled": 0.06
      },
      "priority_weights": {
        "Low": 0.15,
        "Medium": 0.45,
        "High": 0.3,
        "Critical": 0.1
      },
      "required_status_coverage": [
        "Planning",
        "Active",
        "OnHold",
        "Completed",
        "Cancelled"
      ],
      "duration_days": {
        "minimum": 60,
        "maximum": 900
      },
      "unbudgeted_probability": 0.05,
      "taskless_project_fraction": 0.1,
      "require_overlapping_windows": true
    },
    "resources": {
      "active_probability": 0.92,
      "hourly_rate": {
        "minimum_amount": 40,
        "maximum_amount": 350,
        "scale": 2
      },
      "missing_rate_probability": 0.05,
      "missing_department_probability": 0.03,
      "missing_location_probability": 0.03
    },
    "tasks": {
      "date_range": {
        "policy": "within_parent_project_window"
      },
      "status_weights": {
        "NotStarted": 0.18,
        "InProgress": 0.34,
        "Blocked": 0.12,
        "Completed": 0.36
      },
      "required_status_coverage": [
        "NotStarted",
        "InProgress",
        "Blocked",
        "Completed"
      ],
      "duration_days": {
        "minimum": 5,
        "maximum": 365
      },
      "completion_variance_days": {
        "minimum": -30,
        "maximum": 45
      },
      "estimate_hours": {
        "minimum_amount": 1,
        "maximum_amount": 400,
        "scale": 2
      },
      "require_overlapping_windows_within_project": true,
      "require_overdue_examples": true,
      "require_completed_late_examples": true
    },
    "task_resources": {
      "assignment_window": {
        "policy": "within_task_and_project_window"
      },
      "minimum_assignments_per_task": 1,
      "maximum_assignments_per_task": 8,
      "reconcile_to_row_target": true,
      "cover_every_resource": true,
      "require_many_to_many_cardinality": true,
      "allocation": {
        "total_units": 10000,
        "scale": 2,
        "expected_total": "100.00",
        "algorithm": "deterministic_integer_remainder"
      },
      "release_probability": 0.35,
      "release_lag_days": {
        "minimum": 1,
        "maximum": 365
      }
    },
    "milestones": {
      "date_range": {
        "policy": "within_parent_project_window"
      },
      "minimum_per_project": 1,
      "reconcile_to_row_target": true,
      "status_weights": {
        "Planned": 0.28,
        "AtRisk": 0.16,
        "Completed": 0.46,
        "Missed": 0.1
      },
      "required_status_coverage": [
        "Planned",
        "AtRisk",
        "Completed",
        "Missed"
      ],
      "actual_date_variance_days": {
        "minimum": -14,
        "maximum": 45
      }
    },
    "time_entries": {
      "assignment_window": {
        "policy": "within_declared_task_resource_assignment"
      },
      "hours": {
        "minimum_units": 25,
        "maximum_units": 1200,
        "scale": 2
      },
      "billable_probability": 0.78,
      "missing_notes_probability": 0.15,
      "reconcile_to_row_target": true,
      "require_assignment_membership": true
    }
  },
  "business_mappings": {
    "currency_code": "USD",
    "synthetic_names": {
      "project_name": {
        "prefixes_source": "domain_values.project_name_prefixes",
        "subjects_source": "domain_values.project_name_subjects",
        "format": "{prefix} {subject} {project_id:04d}"
      },
      "task_name": {
        "actions_source": "domain_values.task_name_actions",
        "objects_source": "domain_values.task_name_objects",
        "format": "{action} {object} {task_id:05d}"
      },
      "milestone_name": {
        "prefixes_source": "domain_values.milestone_name_prefixes",
        "format": "{prefix} Milestone {milestone_id:05d}"
      }
    },
    "date_semantics": {
      "reference_today_source": "config/generation/base.json:reference_today",
      "overdue": "due_date < reference_today AND completed_date IS NULL",
      "completed_late": "completed_date IS NOT NULL AND due_date IS NOT NULL AND completed_date > due_date",
      "in_progress": "status = 'InProgress'",
      "this_quarter_boundary": "start_inclusive_next_quarter_exclusive",
      "active_assignment": "assigned_at <= reference_today AND (released_at IS NULL OR released_at >= reference_today)",
      "release_date_is_active": true
    },
    "task_status_dates": {
      "completed_status": "Completed",
      "completed_requires_date": true,
      "non_completed_requires_null_date": true
    },
    "milestone_completion": {
      "completed_indicator": "actual_date IS NOT NULL",
      "completed_status": "Completed",
      "output_type": "DECIMAL(5,2)",
      "rounding_mode": "ROUND_HALF_UP",
      "zero_denominator": "NULL",
      "defensive_denominator": "NULLIF(COUNT(*), 0)",
      "require_at_least_one_per_project": true
    },
    "task_resource_many_to_many": {
      "bridge_table": "task_resources",
      "left_entity": "tasks",
      "right_entity": "resources",
      "require_multi_resource_task": true,
      "require_multi_task_resource": true
    },
    "time_entry_assignment_membership": {
      "source_table": "task_resources",
      "fields": [
        "task_id",
        "resource_id"
      ],
      "enforced_as_physical_composite_fk": false,
      "required_by_validator": true
    }
  },
  "decimal_policy": {
    "rounding_mode": "ROUND_HALF_UP",
    "calculation_order": "calculate_first_round_once",
    "binary_float_prohibited": true,
    "stored_scale": 2,
    "allocation_total": "100.00",
    "milestone_percentage_type": "DECIMAL(5,2)"
  },
  "distributions": {
    "project_budget": {
      "preset": "pareto_amount",
      "alpha": 1.3,
      "min_amount": 50000,
      "max_amount": 10000000,
      "scale": 2
    },
    "time_entry_frequency": {
      "preset": "poisson_frequency",
      "lambda": 5.0
    },
    "date_clustering": {
      "preset": "gaussian_mixture_dates"
    }
  },
  "distribution_targets": {
    "project_budget": {
      "table": "projects",
      "field": "budget_amount",
      "distribution": "pareto",
      "settings_key": "project_budget",
      "currency": "USD",
      "preserve_nulls": true
    },
    "time_entry_frequency": {
      "table": "time_entries",
      "group_by_fields": [
        "task_id",
        "resource_id"
      ],
      "distribution": "poisson",
      "settings_key": "time_entry_frequency",
      "reconcile_to_row_target": true
    },
    "date_clustering": {
      "distribution": "gaussian_mixture",
      "settings_key": "date_clustering",
      "targets": [
        "projects.start_date",
        "projects.end_date",
        "tasks.start_date",
        "tasks.due_date",
        "tasks.completed_date",
        "task_resources.assigned_at",
        "task_resources.released_at",
        "milestones.planned_date",
        "milestones.actual_date",
        "time_entries.entry_date"
      ]
    }
  },
  "imperfection_targets": {
    "near_duplicate_time_entries": {
      "table": "time_entries",
      "business_key_fields": [
        "task_id",
        "resource_id",
        "entry_date",
        "work_type"
      ],
      "variation_fields": [
        "hours",
        "notes"
      ],
      "rate_source": "config/generation/base.json:imperfections.duplicate_pct"
    },
    "open_ended_projects": {
      "table": "projects",
      "field": "end_date",
      "eligible_statuses": [
        "Planning",
        "Active",
        "OnHold"
      ],
      "rate_source": "config/generation/base.json:imperfections.null_pct"
    },
    "open_ended_tasks": {
      "table": "tasks",
      "field": "due_date",
      "eligible_statuses": [
        "NotStarted",
        "InProgress",
        "Blocked"
      ],
      "rate_source": "config/generation/base.json:imperfections.null_pct"
    },
    "task_estimate_outliers": {
      "table": "tasks",
      "field": "estimate_hours",
      "rate_source": "config/generation/base.json:imperfections.outlier_pct",
      "minimum_value": 500,
      "maximum_value": 2000,
      "scale": 2
    },
    "coordinated_boundary_dates": {
      "values_source": "config/generation/base.json:imperfections.boundary_dates",
      "targets": [
        "projects.start_date",
        "tasks.start_date",
        "tasks.due_date",
        "milestones.planned_date",
        "time_entries.entry_date"
      ],
      "dependent_updates": [
        "projects.end_date",
        "projects.created_at",
        "tasks.completed_date",
        "tasks.created_at",
        "task_resources.assigned_at",
        "task_resources.released_at",
        "task_resources.created_at",
        "milestones.actual_date",
        "milestones.created_at",
        "time_entries.created_at"
      ],
      "preserve_chronology": true
    }
  }
}
