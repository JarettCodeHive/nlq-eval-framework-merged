{
  "tables": {
    "projects": {
      "primary_key": "project_id",
      "role": "dimension",
      "row_targets": {
        "dev": 10,
        "full": 500
      },
      "fields": [
        {
          "name": "project_id",
          "type": "integer",
          "nullable": false,
          "key": "primary"
        },
        {
          "name": "project_name",
          "type": "varchar",
          "max_length": 255,
          "nullable": false,
          "synthetic_source": "business_mappings.synthetic_names.project_name"
        },
        {
          "name": "project_code",
          "type": "varchar",
          "max_length": 64,
          "nullable": false,
          "synthetic_source": "deterministic_project_code"
        },
        {
          "name": "status",
          "type": "varchar",
          "max_length": 32,
          "nullable": false,
          "synthetic_source": "domain_values.project_statuses"
        },
        {
          "name": "priority",
          "type": "varchar",
          "max_length": 32,
          "nullable": false,
          "synthetic_source": "domain_values.project_priorities"
        },
        {
          "name": "start_date",
          "type": "date",
          "nullable": false,
          "synthetic_source": "generation_rules.projects.date_range",
          "imperfection_target": "coordinated_boundary_date"
        },
        {
          "name": "end_date",
          "type": "date",
          "nullable": true,
          "synthetic_source": "generation_rules.projects.duration_days",
          "imperfection_target": "controlled_null",
          "null_semantics": "Project has no scheduled end."
        },
        {
          "name": "budget_amount",
          "type": "decimal",
          "precision": 15,
          "scale": 2,
          "nullable": true,
          "synthetic_source": "distributions.project_budget",
          "distribution": "pareto",
          "null_semantics": "Project has no approved budget."
        },
        {
          "name": "currency_code",
          "type": "char",
          "max_length": 3,
          "nullable": false,
          "default": "USD",
          "synthetic_source": "business_mappings.currency_code"
        },
        {
          "name": "created_at",
          "type": "timestamp",
          "nullable": false,
          "synthetic_source": "deterministic_timestamp"
        }
      ]
    },
