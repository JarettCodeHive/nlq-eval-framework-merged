        {
          "name": "is_active",
          "type": "boolean",
          "nullable": false,
          "default": true,
          "synthetic_source": "generation_rules.accounts.active_probability"
        },
        {
          "name": "created_at",
          "type": "timestamp",
          "nullable": false,
          "synthetic_source": "deterministic_timestamp"
        }
      ]
    },
    "transactions": {
      "primary_key": "transaction_id",
      "role": "fact",
      "row_targets": {
        "dev": 1000,
        "full": 100000
      },
      "fields": [
        {
          "name": "transaction_id",
          "type": "integer",
          "nullable": false,
