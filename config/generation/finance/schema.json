        {
          "name": "account_type",
          "type": "varchar",
          "max_length": 32,
          "nullable": false,
          "synthetic_source": "domain_values.account_types"
        },
        {
          "name": "account_subtype",
          "type": "varchar",
          "max_length": 64,
          "nullable": true,
          "synthetic_source": "business_mappings.account_subtypes"
        },
        {
          "name": "currency_code",
          "type": "char",
          "max_length": 3,
          "nullable": false,
          "synthetic_source": "domain_values.source_currencies"
