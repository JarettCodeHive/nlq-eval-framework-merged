      "fields": [
        {
          "name": "account_id",
          "type": "integer",
          "nullable": false,
          "key": "primary"
        },
        {
          "name": "account_number",
          "type": "varchar",
          "max_length": 64,
          "nullable": false,
          "key": "unique",
          "synthetic_source": "deterministic_account_number"
        },
        {
          "name": "account_name",
          "type": "varchar",
          "max_length": 255,
          "nullable": false,
          "synthetic_source": "synthetic_chart_of_accounts_name"
