        {
          "name": "parent_account_id",
          "type": "integer",
          "nullable": true,
          "key": "foreign",
          "references": {
            "table": "accounts",
            "field": "account_id"
          },
          "synthetic_source": "generation_rules.accounts.hierarchy"
