SELECT ROUND(
    100.0 * SUM(CASE WHEN q.quote_status = 'Accepted' THEN 1 ELSE 0 END)
    / NULLIF(SUM(CASE WHEN q.quote_status IN ('Accepted', 'Rejected', 'Expired') THEN 1 ELSE 0 END), 0),
    2
) AS accepted_pct
FROM quotations q
INNER JOIN products p ON q.product_id = p.product_id
WHERE p.category = {{ category | sqlstr }};
