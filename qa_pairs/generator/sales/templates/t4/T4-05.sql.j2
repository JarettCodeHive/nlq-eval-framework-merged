SELECT d.stage AS entity, ROUND(SUM(q.quantity * q.unit_price * (1 - q.discount_pct / 100.0)), 2) AS net_revenue
FROM deals d
INNER JOIN quotations q ON d.deal_id = q.deal_id
INNER JOIN products p ON q.product_id = p.product_id
WHERE p.category = {{ category | sqlstr }}
GROUP BY d.stage
ORDER BY net_revenue DESC, entity ASC;
