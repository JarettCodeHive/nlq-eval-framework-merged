SELECT t.period_start AS entity, ROUND(COALESCE(SUM(d.deal_amount), 0), 2) AS won_amount
FROM targets t
LEFT JOIN deals d
    ON d.rep_name = t.rep_name
    AND d.close_date >= t.period_start
    AND d.close_date < t.period_end
    AND d.stage = 'Won'
WHERE t.territory = {{ territory | sqlstr }}
GROUP BY t.period_start
ORDER BY t.period_start ASC;
