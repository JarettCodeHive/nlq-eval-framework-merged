SELECT
  ROUND(SUM(CASE WHEN i.interaction_at >= DATE '2026-04-01' AND i.interaction_at < DATE '2026-07-01' THEN i.engagement_points ELSE 0 END), 2) AS prev_quarter_points,
  ROUND(SUM(CASE WHEN i.interaction_at >= DATE '2026-07-01' AND i.interaction_at < DATE '2026-10-01' THEN i.engagement_points ELSE 0 END), 2) AS this_quarter_points
FROM interactions i INNER JOIN accounts a ON i.account_id = a.account_id
WHERE a.region = '{{ region }}';
