      "required_result": "non_empty_with_unmatched_parent_rows",
      "unmatched_condition": "interactions.campaign_id IS NULL",
      "purpose": "Supports campaigns without attributed interactions."
    },
    {
      "id": "crm_jp_006",
      "name": "interactions_to_campaigns",
      "tier_support": [
        "T3",
        "T4",
        "T5"
      ],
      "join_type": "left",
