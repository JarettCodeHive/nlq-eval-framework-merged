  "join_path_requirements": [
    {
      "id": "crm_jp_001",
      "name": "accounts_to_contacts",
      "tier_support": [
        "T3",
        "T4",
        "T5"
      ],
      "join_type": "left",
      "tables": [
        "accounts",
        "contacts"
      ],
      "join_condition": "accounts.account_id = contacts.account_id",
      "required_result": "non_empty_with_unmatched_parent_rows",
      "unmatched_condition": "contacts.account_id IS NULL",
      "purpose": "Supports accounts without contacts and optional account membership."
    },
    {
      "id": "crm_jp_002",
      "name": "contacts_to_interactions",
      "tier_support": [
        "T3",
        "T4",
        "T5"
      ],
      "join_type": "left",
      "tables": [
        "contacts",
        "interactions"
      ],
      "join_condition": "contacts.contact_id = interactions.contact_id",
      "required_result": "non_empty_with_unmatched_parent_rows",
      "unmatched_condition": "interactions.contact_id IS NULL",
      "purpose": "Supports engagement scoring and contacts without engagement."
    },
    {
      "id": "crm_jp_003",
      "name": "accounts_to_contacts_to_interactions",
      "tier_support": [
        "T4",
        "T5"
      ],
      "join_type": "inner",
      "tables": [
        "accounts",
        "contacts",
        "interactions"
      ],
      "join_condition": "contacts.account_id = accounts.account_id AND interactions.contact_id = contacts.contact_id",
      "required_result": "non_empty",
      "purpose": "Supports account engagement aggregation through contacts."
    },
    {
      "id": "crm_jp_004",
      "name": "contacts_to_contact_campaigns_to_campaigns",
      "tier_support": [
        "T4",
        "T5"
      ],
      "join_type": "inner",
      "tables": [
