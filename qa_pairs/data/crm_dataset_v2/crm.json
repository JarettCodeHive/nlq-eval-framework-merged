        "contact_campaigns",
        "campaigns"
      ],
      "join_condition": "contact_campaigns.contact_id = contacts.contact_id AND contact_campaigns.campaign_id = campaigns.campaign_id",
      "required_result": "non_empty",
      "purpose": "Supports explicit many-to-many campaign participation and attribution."
    },
    {
      "id": "crm_jp_005",
      "name": "campaigns_to_interactions",
      "tier_support": [
        "T3",
        "T4",
        "T5"
      ],
      "join_type": "left",
