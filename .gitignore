.venv/
tmp/
qa_pairs/dataset/
qa_pairs/qa_pairs/

# Generated release outputs. §13.1 wants release/ versioned (Git LFS); until that
# is set up, the bulky and sensitive parts stay out and the §11 deliverables —
# release/<domain>/scorecards/ — stay tracked, because a scorecard nobody can
# check out is not a deliverable. eval-runs/ holds pulse_raw/, ~72KB per question
# of real org data.
release/*/dataset-*/
release/*/qa-pairs-*/
release/*/eval-runs/

# Upload manifests from `dataset-upload`. These record the entity IDs a load
# landed on in ONE Claris org, plus job IDs and absolute local paths — live
# platform state, not a §11 deliverable. Committing them is actively unsafe:
# `dataset-delete` reads a manifest to decide what to remove, and Claris reuses
# entity IDs, so a stale checked-in manifest can name entities that now hold
# somebody else's data. Each machine keeps its own.
release/*/platform/

# Secrets — never commit. judge/.env.example is the checked-in template.
.env
.env.*
!.env.example
*creds*.env

# Judge-owned local state
judge/.judge_cache/
judge/.calibration/
# Legacy run location. Nothing writes here since runs moved under release/, but
# earlier runs still hold live-platform payloads worth keeping on disk.
judge/runs/

# OS / editor cruft
.DS_Store
Thumbs.db

# Python compiled files
*.pyc
*.pyo
*.pyd

# Python cache directories
__pycache__/

# Test / lint / type tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Coverage and packaging output
.coverage
.coverage.*
htmlcov/
*.egg-info/
build/
dist/
