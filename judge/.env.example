# Copy to .env in this folder (or leave in a file named aurecreds.env /
# azurecreds.env — all three are auto-detected). NEVER commit .env.
# `.gitignore` already excludes it.

# Provider is auto-detected:
#   FLOODGATE_NARRATIVE_CERT or FLOODGATE_PROJECT_TOKEN set → Floodgate (Anthropic)
#   AZURE_OPENAI_ENDPOINT set                               → Azure OpenAI
#   otherwise                                               → OpenAI direct
# Force with: LLM_PROVIDER=azure | openai | floodgate
LLM_PROVIDER=

# ---- Anthropic via Floodgate (Apple's model proxy) ---------------------
# All Anthropic traffic MUST go through floodgate.g.apple.com — never
# api.anthropic.com. There is no API key: you authenticate as yourself (an
# AppleConnect token) or as a system account (a Narrative certificate).
#
# Onboard once, per model family, at https://genai.apple.com/profile/onboarding
# A system account does NOT inherit your onboarding — sign in as it and repeat.
#
# Policy: Anthropic models are internal-use only, must not receive InfoSec
# Tier 0/1 data, and since 2026-05-14 may not be used for distillation or
# synthetic data generation. Scoring answers is evaluation and is fine;
# generating the eval dataset with them is not.
#
# LLM_PROVIDER=floodgate
# FLOODGATE_MODEL=anthropic.claude-sonnet-4-6
#   anthropic.claude-sonnet-4-6                  DEFAULT — accepts temperature=0
#   anthropic.claude-haiku-4-5-20251001-v1:0     cheap high-volume, accepts temp=0
#   anthropic.claude-sonnet-5 / -opus-5          DO NOT USE as a judge: they use
#     adaptive thinking and reject `temperature` outright ("ValidationException:
#     `temperature` is deprecated for this model"). With no `seed` on Anthropic
#     that leaves the run with NO determinism control. Verified 2026-09-09.
# FLOODGATE_USER_AGENT=nlq-judge/1.0   # mandatory; how spend is attributed
#
# --- auth, pick one ---
# (a) Local Mac — an AppleConnect token, minted per run and refreshed on expiry.
#     Nothing to set; the CLI is found at /usr/local/bin/appleconnect.
# FLOODGATE_APPLECONNECT=/usr/local/bin/appleconnect
#
# (b) CI / servers — a Narrative mTLS certificate for a system account.
#     Kubernetes: /tls/tls.crt + /tls/tls.key.  Bolt: $BOLT_NARRATIVE_DIR/turi/.
# FLOODGATE_NARRATIVE_CERT=/tls/tls.crt
# FLOODGATE_NARRATIVE_KEY=/tls/tls.key
#
# --- quota ---
# A full run is high-volume and non-interactive, which is exactly what a
# Floodgate project is for. Without a project token it spends your personal
# daily budget (resets 5 AM local). This is the project TOKEN, not the UUID.
# FLOODGATE_PROJECT_TOKEN=
#
# Note: Anthropic has no `seed`. On this provider §10.1 determinism rests on
# temperature=0 alone; the judge warns if a seed is configured, and the run
# manifest records seed=null rather than claiming one was applied. Pick a model
# that accepts temperature=0 (above) or the run has no determinism control at
# all — which JUDGE_REQUIRE_TEMPERATURE_ZERO=true refuses to do silently.
#
# TLS: same corp-proxy story as PULSE_* below — truststore is used automatically.
# FLOODGATE_CA_BUNDLE=
# FLOODGATE_VERIFY_TLS=true

# ---- Azure OpenAI ------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>
AZURE_OPENAI_API_VERSION=2024-06-01
# Azure OpenAI key may live under either name; both work:
AZURE_OPENAI_API_KEY=
OPENAI_API_KEY=

# ---- OpenAI direct (only used when LLM_PROVIDER != azure and no Azure endpoint) --
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini      # judge model; also honours LLM_MODEL
# OPENAI_BASE_URL=            # optional — OpenAI-compatible endpoints
# OPENAI_ORG=                 # optional

# §10.1 wants the judge at temperature 0. GPT-5 / o1-family deployments only
# allow the default temperature. Leave true to fail loudly on such a model;
# set false to run on "model default + fixed seed" instead (the scorecard then
# records judge_temperature_enforced=false).
# JUDGE_REQUIRE_TEMPERATURE_ZERO=true

# ---- Live platform (Claris / Pulse) — used by `--pulse live` (HC-4) ----
# QA only (HC-6). POSTs to
#   {PULSE_BASE_URL}/api-proxy/org/{PULSE_ORG_ID}/ai-svc/v2/tco/chat
PULSE_BASE_URL=https://api-qa.platform.claris.com
PULSE_AUTH_TOKEN=              # the JWT from Chrome DevTools; "Bearer " is added if missing
PULSE_ORG_ID=                  # integer org id (path segment), e.g. 4104
# PULSE_MODEL_NAME=claude-sonnet-5   # default; must be a model the org has enabled
# PULSE_FEATURES=TCOApiV2Feature     # default; sent as X-Claris-Features (empty to omit)
# PULSE_STREAM=false                 # true → consume the SSE stream instead of one JSON body
# PULSE_QUICK_PROMPT=false           # is_quick_prompt in the request body
# PULSE_CHAT_PATH=/api-proxy/org/{org_id}/ai-svc/v2/tco/chat
# PULSE_TIMEOUT_S=180                 # Pulse answers take ~30s each
# PULSE_MAX_RETRIES=3
#
# --- token refresh (optional) --------------------------------------------
# PULSE_AUTH_TOKEN is a browser JWT that lives ONE HOUR. Without refresh, a run
# longer than the token's remaining life is refused up front by the headroom
# check (override with --ignore-token-expiry). Set PULSE_REFRESH_URL and the
# client re-mints its own token 5 minutes before expiry, and once more on a 401,
# which removes the one-hour ceiling on a run.
#
# Refresh is a TWO-STEP chain, because the token Pulse accepts is not the Cognito
# token (captured from Studio's login, 2026-09-21):
#     Cognito  iss=cognito-idp.us-west-2.../us-west-2_JtNIWdiHP  aud=1orc9kni...
#     Pulse    iss=claris.com                                    aud=30henrpr...
# So: Cognito REFRESH_TOKEN_AUTH for fresh Cognito tokens, then POST them to
# {PULSE_BASE_URL}/auth/token, which mints the claris.com token. The Cognito
# refresh token is long-lived (a 30-day default), so this removes the one-hour
# ceiling rather than just extending it.
#
# Capture the refresh token from the request body of Studio's POST to /auth/token
# (DevTools > Network), then:
# PULSE_REFRESH_TOKEN=
# PULSE_COGNITO_CLIENT_ID=1orc9knial20pdfguri4mn40pm   # `clientID` in that body
# PULSE_COGNITO_REGION=us-west-2
# PULSE_AUTH_EXCHANGE_PATH=/auth/token                 # default
#
# Verify the whole chain before trusting it in a run:
#     python judge/pulse_auth.py --probe
#
# CONFIRM-ENDPOINT: the /auth/token *response* shape was not observed, only the
# request. The platform token is therefore located by matching the `aud` of the
# token already in PULSE_AUTH_TOKEN — which is by definition what Pulse accepts —
# so the Cognito id_token in the same response is correctly ignored. If --probe
# reports no matching token, the platform token comes from a third endpoint (see
# the `mag.uri` cookie) and PULSE_AUTH_EXCHANGE_PATH needs repointing.
#
# --- generic single-call refresh (escape hatch) ---------------------------
# For a different environment, or a future BFF-style refresh route. Ignored
# whenever PULSE_REFRESH_TOKEN is set.
# PULSE_REFRESH_URL=
# PULSE_REFRESH_METHOD=GET           # or POST
# PULSE_REFRESH_COOKIE=              # raw Cookie header, e.g. "mag.s=<value>"
# PULSE_REFRESH_BODY=                # optional JSON body, sent when method=POST
# PULSE_REFRESH_HEADERS=             # optional extra headers as a JSON object
#
# A refresh credential is far more sensitive than the hour-long ID token: it is
# long-lived. Keep it in this file only — never in a ticket, commit or chat.
# --- TLS: corp inspection proxies present a private CA. In order of preference:
#     1. leave as-is — the `truststore` package trusts the OS store automatically
#     2. PULSE_CA_BUNDLE=/path/to/corp-ca.pem
#     3. PULSE_VERIFY_TLS=false          (last resort)
# PULSE_CA_BUNDLE=
# PULSE_VERIFY_TLS=true
